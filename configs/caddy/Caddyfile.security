# Caddyfile with Authentik SSO forward auth
# Deployed to /data/caddy/Caddyfile
# Serves all AI workstation services with centralized authentication
#
# Upstreams are addressed by container name and *internal* port over the Docker
# networks caddy joins (ai-workstation, ai-loadout; see docker/compose.caddy.yml),
# so they do not depend on the host's IP (10.10.10.2 never existed here, #51).

# Global options
{
	# TLS handshake fix (TASK-114 / #50): with `tls internal` Caddy only holds
	# certificates for the hostnames listed in site addresses below. A client
	# that connects with any other SNI (or none, e.g. https://<ip>/) used to get
	# TLS alert 80 "internal error" instead of a response.
	#   default_sni  - used when the client sends no SNI (https://<ip>/)
	#   fallback_sni - used when the SNI matches no certificate
	# Both hand back the ai.local certificate so the handshake completes; the
	# HTTPS catch-all site below then answers 404 for unknown Host headers.
	default_sni ai.local
	fallback_sni ai.local
}

(authentik_forward_auth) {
	# Forward auth to Authentik
	forward_auth authentik:9000 {
		uri /outpost.goauthentik.io/auth/caddy
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email
		trusted_proxies private_ranges
		# Send original URI so Authentik can redirect post-auth
		header_up X-Authentik-Redirect-Uri {http.request.uri}
	}
}

# AI Workstation service discovery
# `localhost` is listed so local health/validation probes
# (curl https://localhost/, openssl s_client -connect localhost:443) complete the
# handshake with an internal-CA certificate. Add any extra hostname that clients
# use to reach this box here; Caddy only serves names it has a certificate for.
ai.local, localhost {
	tls internal

	# ────── Root UI ──────────────────────────────────────────────────
	handle / {
		# Redirect to Open WebUI
		redir https://ai.local/webui
	}

	# ────── Open WebUI (Inference Frontend) ──────────────────────────
	handle /webui/* {
		import authentik_forward_auth
		uri strip_prefix /webui
		reverse_proxy open-webui:8080
	}

	# ────── Loadout Manager (GPU Orchestrator) ──────────────────────
	handle /loadout/* {
		import authentik_forward_auth
		uri strip_prefix /loadout
		reverse_proxy loadout-manager:8800 {
			header_up -Upgrade
		}
	}

	# ────── Grafana (Monitoring & Alerting) ────────────────────────
	handle /grafana/* {
		import authentik_forward_auth
		uri strip_prefix /grafana
		reverse_proxy grafana:3000 {
			header_up X-Script-Name /grafana
		}
	}

	# ────── Prometheus (Metrics Database) ──────────────────────────
	handle /prometheus/* {
		import authentik_forward_auth
		uri strip_prefix /prometheus
		reverse_proxy prometheus:9090
	}

	# ────── n8n (Workflow Automation) ──────────────────────────────
	handle /n8n/* {
		import authentik_forward_auth
		uri strip_prefix /n8n
		reverse_proxy n8n:5678 {
			header_up -Upgrade
		}
	}

	# ────── Label Studio (Dataset Annotation) ──────────────────────
	handle /label-studio/* {
		import authentik_forward_auth
		uri strip_prefix /label-studio
		reverse_proxy label-studio:8080
	}

	# ────── JupyterLab (Code & Analysis) ───────────────────────────
	handle /jupyter/* {
		import authentik_forward_auth
		uri strip_prefix /jupyter
		reverse_proxy jupyterlab:8888 {
			header_up -Upgrade
			# WebSocket support for Jupyter
			transport http {
				dial_timeout 10s
				read_timeout 0
				write_timeout 0
			}
		}
	}

	# ────── OpenHands (Autonomous Agent) ───────────────────────────
	handle /openhands/* {
		import authentik_forward_auth
		uri strip_prefix /openhands
		reverse_proxy openhands:3000
	}

	# ────── Langfuse (LLM Observability) ───────────────────────────
	handle /langfuse/* {
		import authentik_forward_auth
		uri strip_prefix /langfuse
		reverse_proxy langfuse:3000
	}

	# ────── Dify (No-Code AI Application) ──────────────────────────
	handle /dify/* {
		import authentik_forward_auth
		uri strip_prefix /dify
		reverse_proxy dify-web:3000 {
			header_up -Upgrade
		}
	}

	# ────── MinIO Console (S3 Storage UI) ──────────────────────────
	handle /minio/* {
		import authentik_forward_auth
		uri strip_prefix /minio
		reverse_proxy minio:9001
	}

	# ────── unauthenticated: Authentik admin setup ─────────────────
	# Allow initial setup without auth
	handle /if/* {
		reverse_proxy authentik:9000
	}

	# Authentik outpost endpoints (internal, no auth)
	handle /outpost.goauthentik.io/* {
		reverse_proxy authentik:9000
	}

	# Health checks (no auth)
	handle /.health {
		respond "OK" 200
	}

	# ────── Fallback ──────────────────────────────────────────────────
	handle {
		respond 404
	}

	# ────── Logging ────────────────────────────────────────────────────
	log {
		format json
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
		}
	}
}

# HTTPS catch-all: a request whose Host header matches none of the names above
# (e.g. https://<ip>/ -- it still completes the handshake thanks to default_sni)
# gets an explicit 404 rather than Caddy's default empty 200.
https:// {
	tls internal
	respond 404
}

# HTTP redirect to HTTPS
:80 {
	redir https://{host}{uri} permanent
}
