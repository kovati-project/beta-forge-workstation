# Authentik secrets template — copy to .env and fill in real values
# Generate each value with: openssl rand -base64 36 | tr -d '\n'
#
# IMPORTANT: .env is in .gitignore — never commit the real values.
# Back up .env separately from this repository (encrypted storage recommended).

POSTGRES_PASSWORD=change-this-to-a-random-password
REDIS_PASSWORD=change-this-to-a-random-password
AUTHENTIK_SECRET_KEY=change-this-to-a-60-char-random-key
