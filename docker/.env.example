# docker/.env — AI Workstation secrets
# Generated by:  bash scripts/init-secrets.sh
# Reset with:    bash scripts/reset-secrets.sh
#
# This file is gitignored and excluded from sync.
# The .env.example file is what ships in the repo/distro.
# init-secrets.sh writes the real docker/.env on first install.

# ── Open WebUI ────────────────────────────────────────────────────────────────
WEBUI_SECRET_KEY=

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=

# ── Dify ──────────────────────────────────────────────────────────────────────
DIFY_SECRET_KEY=
DIFY_DB_PASSWORD=

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_ADMIN_PASSWORD=

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_PASSWORD=

# ── PostgreSQL (shared — langfuse / n8n / dify via init.sql) ─────────────────
POSTGRES_ADMIN_PASSWORD=
LANGFUSE_DB_PASSWORD=

# ── Langfuse ──────────────────────────────────────────────────────────────────
LANGFUSE_NEXTAUTH_SECRET=

# ── Training ──────────────────────────────────────────────────────────────────
LABEL_STUDIO_PASSWORD=
JUPYTER_TOKEN=

# ── Authentik ─────────────────────────────────────────────────────────────────
AUTHENTIK_PG_PASSWORD=
AUTHENTIK_REDIS_PASSWORD=
AUTHENTIK_SECRET_KEY=
