# docker/.env — AI Workstation secrets
# Generated by:  bash scripts/init-secrets.sh
# Reset with:    bash scripts/reset-secrets.sh
#
# This file is gitignored and excluded from sync.
# The .env.example file is what ships in the repo/distro.
# init-secrets.sh writes the real docker/.env on first install.

# ── Workstation host ──────────────────────────────────────────────────────────
# Address browsers and other machines use to reach this workstation. Every
# browser-facing URL in docker/compose.*.yml (Grafana root URL, n8n webhooks,
# Dify web API prefix, ...), the SearXNG base_url and the deploy/validate script
# output are built from it, so changing the host's IP is a one-line edit here.
# An IP (e.g. 192.168.1.102) or a hostname that resolves on the clients
# (e.g. kovati.lan via /etc/hosts or local DNS). Defaults to 10.10.10.2 when unset.
# After changing it: re-run `bash scripts/init-secrets.sh --render-searxng` and
# `docker compose up -d` the affected stacks (agentic, monitoring, loadout, webui).
WORKSTATION_HOST=10.10.10.2

# ── GitHub Container Registry (ghcr.io) ──────────────────────────────────────
# Required to pull private/auth-gated images (e.g. kohya-ss).
# Generate a token at: GitHub → Settings → Developer settings → PAT (classic)
# Scopes needed: read:packages
GHCR_USER=
GHCR_TOKEN=

# ── Open WebUI ────────────────────────────────────────────────────────────────
WEBUI_SECRET_KEY=

# ── Dify ──────────────────────────────────────────────────────────────────────
DIFY_SECRET_KEY=
DIFY_DB_PASSWORD=

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_ADMIN_PASSWORD=

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ROOT_PASSWORD=

# ── PostgreSQL (shared — langfuse / n8n / dify via init.sql) ─────────────────
POSTGRES_ADMIN_PASSWORD=
LANGFUSE_DB_PASSWORD=
# n8n itself runs on SQLite; this is the password of its unused role in the shared postgres
N8N_DB_PASSWORD=

# ── Langfuse ──────────────────────────────────────────────────────────────────
LANGFUSE_NEXTAUTH_SECRET=
# Optional (not a secret). Public URL the browser uses to reach Langfuse; becomes
# NEXTAUTH_URL. Defaults to http://localhost:3002 when unset. Set it when you
# browse from another machine, e.g. http://<WORKSTATION_HOST>:3002
# LANGFUSE_URL=http://localhost:3002

# ── Training ──────────────────────────────────────────────────────────────────
LABEL_STUDIO_PASSWORD=
JUPYTER_TOKEN=

# ── Authentik ─────────────────────────────────────────────────────────────────
AUTHENTIK_PG_PASSWORD=
AUTHENTIK_REDIS_PASSWORD=
AUTHENTIK_SECRET_KEY=
# API token for the loadout-manager admin panel (user and group management).
# Create it in Authentik: Directory -> Tokens and App passwords, intent "API".
AUTHENTIK_TOKEN=
# Optional: override how loadout-manager reaches Authentik.
# AUTHENTIK_URL=http://host.docker.internal:9080
# Authentik image tag (server and worker). Pinned to the version the host runs;
# upgrade one minor release at a time per the Authentik release notes.
AUTHENTIK_TAG=2025.2.4

# ── AI Providers ───────────────────────────────────────────────────────────────
# HuggingFace token for downloading gated models (Llama, Mistral, etc.)
# Generate at: https://huggingface.co/settings/tokens  (scope: read)
HUGGINGFACE_TOKEN=

# Weights & Biases API key for training run logging (optional)
# Generate at: https://wandb.ai/settings
WANDB_API_KEY=

# ── Voice (compose.voice.yml) ─────────────────────────────────────────────────
# Optional (not secrets). The Whisper STT model is chosen HERE and nowhere else:
# compose.voice.yml passes it to faster-whisper-server as WHISPER__MODEL, every
# "whisper-1" request (Open WebUI, Loadout Manager) resolves to it, and
# scripts/pull-voice-models.sh pre-downloads the same repo id. Defaults shown.
# WHISPER_MODEL=Systran/faster-whisper-large-v3
# WHISPER_COMPUTE_TYPE=int8_float16
# PIPER_VOICE=en_US-lessac-high

# ── Image pins (optional) ─────────────────────────────────────────────────────
# vLLM image tag for vllm-pair-a, vllm-pair-b and vllm-4gpu. Defaults to the tag
# pinned in compose.inference.yml. Set it to the version a host already runs to
# keep that host unchanged on the next pull.
# VLLM_TAG=v0.34.0
